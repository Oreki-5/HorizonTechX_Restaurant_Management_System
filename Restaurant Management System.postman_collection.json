        {
          "name": "Add bulk items in Inventory",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"inventoryList\": [\r\n        {\r\n            \"itemId\": 1,\r\n            \"itemName\": \"tomato\",\r\n            \"unitOfMeaure\": \"kg\",\r\n            \"lastUpdatedStock\": 100\r\n        },\r\n        {\r\n            \"itemId\": 2,\r\n            \"itemName\": \"onion\",\r\n            \"unitOfMeaure\": \"kg\",\r\n            \"lastUpdatedStock\": 100\r\n        },\r\n        {\r\n            \"itemId\": 3,\r\n            \"itemName\": \"capsicum\",\r\n            \"unitOfMeaure\": \"kg\",\r\n            \"lastUpdatedStock\": 100\r\n        },\r\n        {\r\n            \"itemId\": 4,\r\n            \"itemName\": \"mirchi masala\",\r\n            \"unitOfMeaure\": \"kg\",\r\n            \"lastUpdatedStock\": 100\r\n        },\r\n        {\r\n            \"itemId\": 5,\r\n            \"itemName\": \"garam masala\",\r\n            \"unitOfMeaure\": \"kg\",\r\n            \"lastUpdatedStock\": 100\r\n        },\r\n        {\r\n            \"itemId\": 6,\r\n            \"itemName\": \"cabbage\",\r\n            \"unitOfMeaure\": \"amount\",\r\n            \"lastUpdatedStock\": 200\r\n        }\r\n    ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
